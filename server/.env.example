# LAN IPv4 of this host; published ports bind to this address only.
LAN_IP=192.168.100.13
# DeepSeek API key (used by LiteLLM in a later milestone).
DEEPSEEK_API_KEY=placeholder-not-a-secret
# Master key for LiteLLM; also rendered into the xiaozhi config.
LITELLM_MASTER_KEY=placeholder-not-a-secret
# Postgres password for LiteLLM's database (later milestone).
LITELLM_DB_PASSWORD=placeholder-not-a-secret
